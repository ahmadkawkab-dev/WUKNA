#!/usr/bin/env python3
"""Generate a restricted Library credential; never print it or overwrite secrets."""
import argparse
import json
import os
from pathlib import Path
import secrets

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("directory", help="Private directory outside the repository")
args = parser.parse_args()
directory = Path(args.directory).resolve()
repository = Path(__file__).resolve().parent.parent
if directory == repository or repository in directory.parents:
    parser.error("Choose a private directory outside the repository.")
os.umask(0o077)
directory.mkdir(parents=True, exist_ok=True, mode=0o700)
if any((directory / name).exists() for name in ("library-s3.json", "storage.env")):
    parser.error("Existing credentials will not be overwritten.")
access = secrets.token_hex(10)
secret = secrets.token_hex(32)
config = {"identities": [{"name": "wukna-library", "credentials": [{"accessKey": access, "secretKey": secret}],
                         "actions": ["Read:wukna-library", "Write:wukna-library"]}]}
with (directory / "library-s3.json").open("x") as stream:
    json.dump(config, stream)
with (directory / "storage.env").open("x") as stream:
    stream.write(f"LIBRARY_S3_CONFIG_FILE={directory}/library-s3.json\nLIBRARY_S3_ACCESS_KEY={access}\nLIBRARY_S3_SECRET_KEY={secret}\n")
print("Created private Library storage configuration; credential values were not printed.")
